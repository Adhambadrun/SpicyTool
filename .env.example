# SpicyTool environment
# Third-party provider credentials stay BLANK by default.
# Each adapter is inert until an operator supplies a credential issued
# directly to them by that provider. Never hardcode credentials.

AWARDTOOL_API_KEY=
POINTSPATH_API_KEY=
POINTSYEAH_API_KEY=

# Flybasis (Socket.IO / WebSocket award feed — https://flybasis.com)
# Credential issued by Flybasis; sent as the socket auth token.
FLYBASIS_API_KEY=

# Modeled first-party engine (SAMPLE data, not live availability).
# Off by default so searches only ever show real provider results.
# Set to 1 only for demos / offline tests.
SPICYTOOL_MODELED_ENGINE=0

# Cache / engine tuning
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=2700
PROVIDER_TIMEOUT=3.5
