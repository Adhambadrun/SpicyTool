# SpicyTool environment
# Third-party provider credentials stay BLANK by default.
# Each adapter is inert until an operator supplies a credential issued
# directly to them by that provider. Never hardcode credentials.

AWARDTOOL_API_KEY=
POINTSPATH_API_KEY=
# PointsYeah (https://pointsyeah.com) — free tier available; API key from
# the account. Also see SeatsAero below, the other live award option.
POINTSYEAH_API_KEY=

# Seats.aero partner API (cached award availability — ~20 mileage programs,
# points, seats, cabins, airlines; NOT in the default relay set).
# Key: seats.aero/settings -> API tab (Pro account; up to 1,000 calls/day,
# non-commercial unless you have a written agreement with Seats.aero).
# Enable with: SPICYTOOL_PROVIDERS=SeatsAero   (or "all").
SEATS_AERO_API_KEY=
# SEATS_AERO_BASE_URL=https://seats.aero/partnerapi

# Flybasis (Socket.IO / WebSocket award feed — https://flybasis.com)
# Credential issued by Flybasis; sent as the socket auth token.
# This is the ONLY provider searched by default — see SPICYTOOL_PROVIDERS.
# How to obtain + verify the key: see FLYBASIS_GO_LIVE.md (repo root).
FLYBASIS_API_KEY=

# ── Flybasis SESSION mode (advanced; use at your own risk) ────────────────────
# Same feed, authenticated with YOUR OWN Flybasis account session (the flow the
# website uses: Supabase login -> access_token -> socket auth token). It is NOT
# a Flybasis-issued API token: it consumes your account's search quota and
# automated use may violate Flybasis terms of service. The official key above is
# preferred; session mode is used when no official award-feed token is set.
# A misplaced RapidAPI key is ignored by award auth, not sent to the socket.
# BOTH the Supabase app key and an account credential are required.
# Use the LATEST successful auth RESPONSE's refresh_token, not the request's
# already-used token. Private HAR setup (no token output / no network):
#   python3 backend/tools/import_flybasis_har.py /path/to/private.har
# This creates .env only if it does not exist. NEVER commit these values.
# Revoke any publicly exposed session before importing a fresh private capture.
# Rotations are kept in memory + a private, atomic per-instance token file.
# Vercel /tmp is ephemeral, NOT shared across replicas: a refresh token in env
# alone is not durable serverless auth. Prefer an official token or, where
# permitted, independent password-grant sessions. See FLYBASIS_GO_LIVE.md.
# FLYBASIS_SUPABASE_URL=https://sb.flybasis.com
# FLYBASIS_SUPABASE_ANON_KEY=
# FLYBASIS_REFRESH_TOKEN=
# FLYBASIS_EMAIL=            # password-grant fallback (instead of refresh)
# FLYBASIS_PASSWORD=

# OPTIONAL: point the award socket somewhere other than the production host
# (a partner/staging endpoint, or a local mock). Leave unset in production.
# Mirrors AGENTSEARCH_BASE_URL, and it is what lets
# `python3 backend/tools/verify_flybasis_socket.py` exercise the real
# handshake + normalization with no credential and no outbound network.
# FLYBASIS_BASE_URL=https://enterprise-api.flybasis.com

# Which providers the search relays. Default is Flybasis only: every result
# shown to a user is Flybasis search-engine output.
#   SPICYTOOL_PROVIDERS=all                 -> every adapter (demos/sweeps)
#   SPICYTOOL_PROVIDERS=Flybasis,PointsPath -> an explicit subset
SPICYTOOL_PROVIDERS=Flybasis

# AgentSearch (RapidAPI) — OPTIONAL, general web search only.
# Preferred backend for the "Web context" panel. When set, SpicyTool calls
# https://agentsearch.p.rapidapi.com/v1/search directly instead of the keyless
# MCP connector below (which stays as the automatic fallback).
# NOT an award feed: AgentSearch returns web pages, never availability, points
# or seat counts, and nothing it returns is merged into search results.
# Get a key at rapidapi.com (subscribe to the AgentSearch API).
# Note: if FLYBASIS_API_KEY is set to a RapidAPI-shaped key (…msh…jsn…) it is
# used here automatically and is NOT dialled at the Flybasis award socket.
# Endpoints used: /v1/search (SERP), /v1/answer (instant answer), /v1/fetch
# (URL -> clean text/markdown). /api/health is not wrapped.
AGENTSEARCH_API_KEY=
AGENTSEARCH_PROVIDER=brave
AGENTSEARCH_COUNTRY=us
AGENTSEARCH_TIMEOUT=12

# Optional MCP fallback: the official AgentSearch MCP connector. Same 3-tool
# surface as the keyless FlyBasis connector, so either URL is accepted.
# AGENTSEARCH_MCP_URL=https://agentsearch-mcp.vercel.app/mcp

# FlyBasis Search MCP connector — OPTIONAL, general web context only.
# This is NOT the award feed. It supplies the "Web context" panel on the
# itinerary view (web search / instant answers / page text) and is a separate
# deployment from the Flybasis award-flight provider above. Everything it
# returns is labelled is_award_data=false and is never merged into results.
# Leave blank/unset and the panel simply reports unavailable.
FLYBASIS_MCP_URL=https://flybasis-mcp.vercel.app/mcp
FLYBASIS_MCP_TIMEOUT=12

# Modeled first-party engine (SAMPLE data, not live availability).
# Off by default so searches only ever show real provider results.
# Set to 1 only for demos / offline tests (and only alongside
# SPICYTOOL_PROVIDERS=all, since it is not searched by default).
SPICYTOOL_MODELED_ENGINE=0

# Cache / engine tuning
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=2700
PROVIDER_TIMEOUT=3.5
