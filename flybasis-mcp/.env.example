# flybasis-mcp is KEYLESS by default — nothing here is required to run.
# Copy to .env only when you want to override defaults.

# Soft per-IP tools/call limit per hour (in-memory, per serverless instance)
FLYBASIS_MCP_RATE_LIMIT=30

# Optional: upgrade web_search to a commercial SERP provider (no key = DuckDuckGo Lite + Wikipedia)
FLYBASIS_MCP_BRAVE_KEY=
FLYBASIS_MCP_SERPER_KEY=

# Optional backward-compat: point at an upstream REST API and forward instead of
# using the built-in keyless tools. FLYBASIS_MCP_FORCE_LEGACY=1 forces it.
FLYBASIS_MCP_API_BASE_URL=
FLYBASIS_MCP_PROXY_SECRET=
FLYBASIS_MCP_FORCE_LEGACY=0
